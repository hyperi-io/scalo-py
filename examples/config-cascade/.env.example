# Copy this file to .env and customise for local development
# .env files are gitignored and should contain local secrets

# A double underscore nests the key: DATABASE__HOST sets database.host.

# Database credentials (never commit real values)
DATABASE__HOST="localhost"
DATABASE__PORT="5432"
DATABASE__USER="myapp"
DATABASE__PASSWORD="secret"

# API configuration
API__PORT="8000"

# Logging
LOG_LEVEL="DEBUG"
