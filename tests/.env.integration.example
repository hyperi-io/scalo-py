# Integration test configuration
# Copy to tests/.env.integration, then uncomment and fill in each provider you test
# git ignores tests/.env.integration, so the copy is never committed

# ---------------------------------------------------------------------------
# AWS Secrets Manager
# ---------------------------------------------------------------------------

# TEST_AWS_REGION=<region>
TEST_AWS_SECRET_NAME=scalo-test

# Credentials via SSO (run before tests):
#   aws sso login --profile <profile>
#   eval $(aws configure export-credentials --profile <profile> --format env)
#
# Or set directly:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# ---------------------------------------------------------------------------
# GCP Secret Manager
# ---------------------------------------------------------------------------

# TEST_GCP_PROJECT_ID=<project-id>
TEST_GCP_SECRET_NAME=scalo-test

# Credentials via ADC (run once):
#   gcloud auth application-default login

# ---------------------------------------------------------------------------
# Azure Key Vault
# ---------------------------------------------------------------------------

# TEST_AZURE_VAULT_URL=https://<vault-name>.vault.azure.net/
TEST_AZURE_SECRET_NAME=scalo-test

# Credentials via Azure CLI (run once):
#   az login
#
# Note: if AZURE_CLIENT_SECRET is set in your environment with a stale value,
# unset it before running tests, because it overrides CLI auth:
#   unset AZURE_CLIENT_SECRET

# ---------------------------------------------------------------------------
# OpenBao / Vault
# ---------------------------------------------------------------------------

# TEST_VAULT_ADDR=https://<openbao-host>:8200
# TEST_VAULT_TOKEN=<token-from-openbao>
TEST_VAULT_PATH=secret/data/scalo-test
TEST_VAULT_KEY=api_key
