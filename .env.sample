# scalo-py local settings
#
# Copy this file to .env, which git ignores. With no env prefix set, the
# config cascade and the test suite read these names as written.

# Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=json   # json, text or auto

# Shared test services: an always-present ClickHouse and Kafka the core tier
# uses in place of containers when a quick probe answers. tests/TESTING.md says
# when each is used, and HYPERI_TEST_ENV_FILE names a further file to read.
# HYPERI_TEST_CLICKHOUSE_HOST=
# HYPERI_TEST_CLICKHOUSE_USER=
# HYPERI_TEST_CLICKHOUSE_PASSWORD=
# HYPERI_TEST_KAFKA_BOOTSTRAP=
# HYPERI_TEST_KAFKA_USER=
# HYPERI_TEST_KAFKA_PASSWORD=
