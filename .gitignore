# Local environment files (never commit -- contain secrets). The negations name
# the sample files this repo actually tracks: `.env.*` matches at any depth, and
# a tracked file that its own ignore rules shadow cannot be re-added once it is
# removed.
.env
.env.*
!.env.example
!.env.example.*
!.env.sample
!*.example
tests/.env.integration

# Credentials. Git has no trailing comments -- a pattern is the whole line.
.pip/
.keys/
.keys/*
!.keys/.gitkeep
*.key
*.pem
*.crt
*.cert

# Version control local overrides
.git/
.gitattributes.local
.gitignore.local

# Git worktrees (local dev convenience)
.worktrees/

# Logs and build noise
*.log
ci-local/logs/
.test-*

# AI agent working files -- local-only, never committed. Mirrored in
# .git/info/exclude, because a tracked .gitignore alone does not protect a
# clone that has not pulled it yet.
docs/superpowers/
.hyperi-ai
hyperi-ai/
CLAUDE.md
STATE.md
TODO.md
AGENTS.md
GEMINI.md
.ai-version
.mcp.json
.claude/
.codex/
.cursor/
.gemini/
.cursorrules

# Local scratch / tmp (CORE.md: scratch goes here, gitignored, NOT
# /tmp). Bare patterns (no leading slash) match a tmp dir at ANY
# depth, so these cover top-level .tmp/ and tmp/ as well as nested
# ones like tests/tmp/.
.tmp/
tmp/
*.tmp
*.temp
*.bak
